# credit-risk-platform — environment configuration
#
# Quickstart: `cp .env.example .env` and fill in values. Both docker-compose
# and the Python/R pipelines honor these (docker-compose via ${VAR}
# substitution; Python via pipeline/config.py which calls load_dotenv();
# R via Sys.getenv() fallback in R/*/01_prepare.R).
#
# The .env file is git-ignored — never commit real secrets.

# ==== Postgres (docker-compose + application) ================================
DB_HOST=localhost
DB_PORT=5433             # host port; mapped to container 5432
DB_USER=credit_user
DB_PASSWORD=change_me_before_you_push_anywhere
DB_NAME=credit_risk

# ==== FRED (macro data) ======================================================
# Optional — pandas_datareader works against the public FRED endpoint without
# a key. Set this only if you hit rate limits.
# FRED_API_KEY=

# ==== Kaggle (only needed if you regenerate the LendingClub sample on Colab) =
# The pipeline itself does NOT use Kaggle — see README's Colab block for
# where kaggle.json is uploaded (in Colab, not locally). Never put your
# kaggle.json content here or anywhere in the repo.

# ==== MLflow =================================================================
# Local file store by default; override to a remote tracking server if needed.
MLFLOW_TRACKING_URI=./mlruns
